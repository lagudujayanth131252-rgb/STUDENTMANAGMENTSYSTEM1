    "name": "Student Management System - CRUD API Testing & Error Handling",
    "description": "Comprehensive Postman test collection for Student Management System CRUD API covering:\n1. Valid Input Scenarios (Positive CRUD Flow)\n2. Invalid Input Scenarios (Format, Boundary, and Conflict Checks)\n3. Missing Input Scenarios (Required Field Validations)\nIncludes automated pm.test assertions for HTTP status codes, response schemas, and error message validation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
