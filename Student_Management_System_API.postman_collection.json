  "item": [
    {
      "name": "1. Valid Input (Positive CRUD Tests)",
      "description": "Happy path testing with well-formed, complete, and valid parameters.",
      "item": [
        {
          "name": "POST - Create Student (Valid Input)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response time is below 500ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(500);",
                  "});",
                  "",
                  "pm.test(\"Response returns success: true and data object\", function () {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.success).to.be.true;",
                  "    pm.expect(res.data).to.be.an('object');",
                  "    pm.expect(res.data.grno).to.eql(\"92400120999\");",
                  "    pm.expect(res.data.name).to.eql(\"Rohit Sharma\");",
                  "    pm.expect(res.data.department).to.eql(\"Computer Engineering\");",
                  "    pm.expect(res.data.sem).to.eql(6);",
                  "    pm.expect(res.data.fees).to.eql(52000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grno\": \"92400120999\",\n  \"name\": \"Rohit Sharma\",\n  \"department\": \"Computer Engineering\",\n  \"sem\": 6,\n  \"fees\": 52000,\n  \"isScholarship\": false,\n  \"email\": \"rohit.sharma@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/students",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students"]
            }
          }
        },
        {
